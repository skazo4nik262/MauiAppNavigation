<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.StudentAddServicesView"
             Title="StudentAddServicesView">
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Label Text="FIO" Margin="0,12,10,0"/>
            <Entry Text="{Binding Student.FIO}" Placeholder="FIO" PlaceholderColor="LightGray"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Birthday" Margin="0,12,10,0"/>
            <Entry Text="{Binding Student.Birthday}" Placeholder="Birthday" PlaceholderColor="LightGray"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Address" Margin="0,12,10,0"/>
            <Entry Text="{Binding Student.Address}" Placeholder="Address" PlaceholderColor="LightGray"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label Text="IsBoy" Margin="0,12,10,0"/>
            <Slider IsEnabled="{Binding Student.IsBoy}"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Group" Margin="0,12,10,0"/>
            <Picker ItemsSource="{Binding Groups}" ItemDisplayBinding="{Binding Number}" SelectedItem="{Binding SelectedGroup}" />
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Button Text="Save" Clicked="SaveClick"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>